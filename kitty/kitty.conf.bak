# Fonts
font_family      JetBrainsMono Nerd Font Mono
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        14.0
adjust_line_height 110%
adjust_column_width 0

# TokyoNight Night
background            #16161e
foreground            #c0caf5
cursor                #7aa2f7
cursor_text_color     background
selection_background  #283457
selection_foreground  #c0caf5

# ANSI
color0  #15161e
color8  #414868
color1  #f7768e
color9  #f7768e
color2  #73daca
color10 #73daca
color3  #e0af68
color11 #e0af68
color4  #7aa2f7
color12 #7aa2f7
color5  #bb9af7
color13 #bb9af7
color6  #7dcfff
color14 #7dcfff
color7  #a9b1d6
color15 #c0caf5

# Window
window_padding_width      12
background_opacity        0.97
background_blur           20
draw_minimal_borders      yes
window_border_width       1pt
active_border_color       #7aa2f7
inactive_border_color     #292e42
bell_border_color         #f7768e

# macOS 26 — rounded corners, no titlebar
hide_window_decorations        yes
macos_titlebar_color           background
macos_option_as_alt            yes
macos_quit_when_last_window_closed no
macos_window_resizable         yes
macos_colorspace               displayp3

# Layouts
enabled_layouts    splits,fat,grid,stack
remember_window_size yes
placement_strategy center

# Tab Bar
tab_bar_edge            top
tab_bar_style           powerline
tab_powerline_style     round
tab_bar_min_tabs        1
active_tab_foreground   #16161e
active_tab_background   #7aa2f7
active_tab_font_style   bold
inactive_tab_foreground #7aa2f7
inactive_tab_background #1f2335
inactive_tab_font_style normal
tab_title_template      "{index}: {title}"
tab_bar_background      #16161e

# Performance
repaint_delay    8
input_delay      3
sync_to_monitor  yes
scrollback_lines 200000

# Notifications
notify_on_cmd_finish invisible 5

# Shell
shell_integration enabled
enable_audio_bell no
visual_bell_duration 0

# Resize
map alt+left  resize_window narrower 5
map alt+right resize_window wider 5
map alt+up    resize_window taller 5
map alt+down  resize_window shorter 5
map alt+=     resize_window reset

# Tabs
map cmd+t         new_tab_with_cwd
map cmd+w         close_tab
map cmd+1         goto_tab 1
map cmd+2         goto_tab 2
map cmd+3         goto_tab 3
map cmd+4         goto_tab 4
map cmd+5         goto_tab 5
map cmd+shift+[   previous_tab
map cmd+shift+]   next_tab

# Splits
map cmd+shift+enter launch --location=vsplit --cwd=current
map cmd+enter       launch --location=hsplit --cwd=current
map cmd+[           previous_window
map cmd+]           next_window

# Layouts
map cmd+shift+l next_layout
map cmd+shift+r layout_action rotate

# Hints
map cmd+shift+o kitten hints
map cmd+shift+u kitten hints --type=url
map cmd+shift+f kitten hints --type=path

# Clipboard
copy_on_select       yes
strip_trailing_spaces smart

# Broadcast
map cmd+shift+b toggle_input_broadcast

# Config
map cmd+shift+, edit_config_file
map cmd+shift+. load_config_file

# Search
map cmd+shift+/ show_scrollback

# Session
allow_remote_control yes
